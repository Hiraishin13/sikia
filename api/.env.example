# Copiez ce fichier en `.env` (ignoré par git) et remplissez ce dont vous avez besoin.
# Une variable déjà définie dans l'environnement l'emporte sur ce fichier.

# --- Traducteur gloses → phrase (un seul suffit ; sans clé : traducteur factice) ---
# Gemini, offre gratuite : clé sur https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Claude (payant, très peu cher avec Haiku)
ANTHROPIC_API_KEY=

# claude | gemini | stub | auto (défaut : Claude si sa clé existe, sinon Gemini, sinon factice)
#SIKIA_TRANSLATOR=auto
#SIKIA_GEMINI_MODEL=gemini-3.5-flash-lite
#SIKIA_LLM_MODEL=claude-haiku-5-5

# Délai avant de montrer les gloses brutes. 2 s par défaut ; l'offre gratuite de Gemini est trop
# irrégulière pour cela (médiane ~1,5 s, p90 ~2,6 s, erreurs 503/429) : 4 est un bon réglage.
#SIKIA_TRANSLATE_TIMEOUT_S=4

# --- Reconnaissance de signes (dossier produit par ml/) ---
#SIKIA_MODEL_DIR=../ml/runs/v20261121-101500
